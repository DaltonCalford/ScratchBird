        "CC": "clang",
        "CXX": "clang++"
      },
      "inherits": "base-ninja-debug",
      "name": "linux-clang-debug"
    },
    {
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
      },
      "condition": {
        "lhs": "${hostSystemName}",
        "rhs": "Linux",
        "type": "equals"
      },
      "description": "Cross-compile from Linux to Windows x64 using MinGW-w64.",
      "displayName": "Linux MinGW to Windows x64",
      "inherits": "base-ninja-debug",
      "name": "linux-mingw-windows-x64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake"

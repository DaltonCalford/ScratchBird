        "SCRATCHBIRD_CTEST_TIMEOUT": "3600"
      },
      "generator": "Ninja",
      "hidden": true,
      "name": "base-ninja-debug"
    },
    {
      "condition": {
        "lhs": "${hostSystemName}",
        "rhs": "Linux",
        "type": "equals"
      },
      "description": "Primary Linux GCC configure preset for portability and CI smoke.",

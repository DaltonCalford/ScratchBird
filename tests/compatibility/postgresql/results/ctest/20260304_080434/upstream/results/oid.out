--
-- OID
--
CREATE TABLE OID_TBL(f1 oid);
INSERT INTO OID_TBL(f1) VALUES ('1234');
INSERT INTO OID_TBL(f1) VALUES ('1235');
INSERT INTO OID_TBL(f1) VALUES ('987');
INSERT INTO OID_TBL(f1) VALUES ('-1040');
INSERT INTO OID_TBL(f1) VALUES ('99999999');
INSERT INTO OID_TBL(f1) VALUES ('5     ');
INSERT INTO OID_TBL(f1) VALUES ('   10  ');
-- leading/trailing hard tab is also allowed
INSERT INTO OID_TBL(f1) VALUES ('	  15 	  ');
-- bad inputs
INSERT INTO OID_TBL(f1) VALUES ('');
ERROR:  Type mismatch for column 'f1':  is not a number (value: '', target: INT32)
INSERT INTO OID_TBL(f1) VALUES ('    ');
ERROR:  Type mismatch for column 'f1':  is not a number (value: '    ', target: INT32) (value:     )
INSERT INTO OID_TBL(f1) VALUES ('asdfasd');
ERROR:  Type mismatch for column 'f1': asdfasd is not a number (value: 'asdfasd', target: INT32) (value: asdfasd)
INSERT INTO OID_TBL(f1) VALUES ('99asdfasd');
ERROR:  Type mismatch for column 'f1': 99asdfasd is not a number (value: '99asdfasd', target: INT32) (value: 99asdfasd)
INSERT INTO OID_TBL(f1) VALUES ('5    d');
ERROR:  Type mismatch for column 'f1': 5    d is not a number (value: '5    d', target: INT32) (value: 5    d)
INSERT INTO OID_TBL(f1) VALUES ('    5d');
ERROR:  Type mismatch for column 'f1': 5d is not a number (value: '    5d', target: INT32) (value:     5d)
INSERT INTO OID_TBL(f1) VALUES ('5    5');
ERROR:  Type mismatch for column 'f1': 5    5 is not a number (value: '5    5', target: INT32) (value: 5    5)
INSERT INTO OID_TBL(f1) VALUES (' - 500');
ERROR:  Type mismatch for column 'f1': - 500 is not a number (value: ' - 500', target: INT32) (value:  - 500)
INSERT INTO OID_TBL(f1) VALUES ('32958209582039852935');
ERROR:  Type mismatch for column 'f1': INT32 value out of range (value: '32958209582039852935', target: INT32) (value: 32958209582039852935)
INSERT INTO OID_TBL(f1) VALUES ('-23582358720398502385');
ERROR:  Type mismatch for column 'f1': INT32 value out of range (value: '-23582358720398502385', target: INT32) (value: -23582358720398502385)
SELECT * FROM OID_TBL;
    f1    
----------
     1234
     1235
      987
    -1040
 99999999
        5
       10
       15
(8 rows)

-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('1234', 'oid');
 expr1 
-------
 
(1 row)

SELECT pg_input_is_valid('01XYZ', 'oid');
 expr1 
-------
 
(1 row)

SELECT * FROM pg_input_error_info('01XYZ', 'oid');
ERROR:  Parse error at line 1, column 34: Unexpected token after statement
SELECT pg_input_is_valid('9999999999', 'oid');
 expr1 
-------
 
(1 row)

SELECT * FROM pg_input_error_info('9999999999', 'oid');
ERROR:  Parse error at line 1, column 34: Unexpected token after statement
-- While we're here, check oidvector as well
SELECT pg_input_is_valid(' 1 2  4 ', 'oidvector');
 expr1 
-------
 
(1 row)

SELECT pg_input_is_valid('01 01XYZ', 'oidvector');
 expr1 
-------
 
(1 row)

SELECT * FROM pg_input_error_info('01 01XYZ', 'oidvector');
ERROR:  Parse error at line 1, column 34: Unexpected token after statement
SELECT pg_input_is_valid('01 9999999999', 'oidvector');
 expr1 
-------
 
(1 row)

SELECT * FROM pg_input_error_info('01 9999999999', 'oidvector');
ERROR:  Parse error at line 1, column 34: Unexpected token after statement
SELECT o.* FROM OID_TBL o WHERE o.f1 = 1234;
  f1  
------
 1234
(1 row)

SELECT o.* FROM OID_TBL o WHERE o.f1 <> '1234';
    f1    
----------
     1235
      987
    -1040
 99999999
        5
       10
       15
(7 rows)

SELECT o.* FROM OID_TBL o WHERE o.f1 <= '1234';
  f1   
-------
  1234
   987
 -1040
     5
    10
    15
(6 rows)

SELECT o.* FROM OID_TBL o WHERE o.f1 < '1234';
  f1   
-------
   987
 -1040
     5
    10
    15
(5 rows)

SELECT o.* FROM OID_TBL o WHERE o.f1 >= '1234';
    f1    
----------
     1234
     1235
 99999999
(3 rows)

SELECT o.* FROM OID_TBL o WHERE o.f1 > '1234';
    f1    
----------
     1235
 99999999
(2 rows)

DROP TABLE OID_TBL;

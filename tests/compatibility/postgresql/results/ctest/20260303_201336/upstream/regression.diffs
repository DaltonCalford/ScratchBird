-               Hash Cond: (t3_2.a = t1_2.a)
-               ->  Seq Scan on prt3_adv_p2 t3_2
-               ->  Hash
-                     ->  Hash Right Join
-                           Hash Cond: (t2_1.b = t1_2.a)
-                           ->  Seq Scan on prt2_adv_p1 t2_1
-                           ->  Hash
-                                 ->  Seq Scan on prt1_adv_p1 t1_2
-                                       Filter: (b = 0)

-HINT:  Valid encodings are "base64", "base64url", "escape", and "hex".
-SELECT decode('00', 'invalid');           -- error
-ERROR:  unrecognized encoding: "invalid"
-HINT:  Valid encodings are "base64", "base64url", "escape", and "hex".

-                     Output: i4.f1
-                     Filter: (i4.f1 = ((64)::information_schema.cardinal_number)::integer)
-         ->  Seq Scan on public.int8_tbl i8
-               Output: i8.q1, i8.q2
-               Filter: (i8.q1 = ((64)::information_schema.cardinal_number)::integer)
-(33 rows)

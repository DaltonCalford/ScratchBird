-  (VALUES('0'::numeric),('-4.2'),('4.2e9'),('1.2e-5'),('inf'),('-inf'),('nan'))
-SELECT val,
-  to_char(val, 'MI9999999999.99') as numeric,
-  to_char(val::float8, 'MI9999999999.99') as float8,
-  to_char(val::float4, 'MI9999999999.99') as float4
-FROM v;

-   RETURNS bool
-   AS :'regresslib'
-   LANGUAGE C STRICT;
-CREATE OPERATOR <% (
-   leftarg = point,
-   rightarg = widget,
-   procedure = pt_in_widget,
-   commutator = >% ,
-   negator = >=%
-);

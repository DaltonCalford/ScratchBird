-ERROR:  SELECT ... INTO is not allowed here
-LINE 1: SELECT * FROM (SELECT 1 INTO f) bar;
-                                     ^
-CREATE VIEW foo AS SELECT 1 INTO int4_tbl;
-ERROR:  views must not contain SELECT INTO
-INSERT INTO int4_tbl SELECT 1 INTO f;
-ERROR:  SELECT ... INTO is not allowed here

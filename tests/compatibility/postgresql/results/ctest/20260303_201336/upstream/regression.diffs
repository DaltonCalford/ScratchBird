--- Test eager aggregation with GEQO
---
-SET geqo = on;
-SET geqo_threshold = 2;
-EXPLAIN (VERBOSE, COSTS OFF)
-SELECT t1.a, avg(t2.c)
-  FROM eager_agg_t1 t1
-  JOIN eager_agg_t2 t2 ON t1.b = t2.b

-   Output: t1.a
-   Join Filter: (t1.b = t3.b)
-   ->  Seq Scan on public.sj t1
-         Output: t1.a, t1.b, t1.c
-   ->  Materialize
-         Output: t3.c, t3.b
-         ->  Seq Scan on public.sj t3
-               Output: t3.c, t3.b
-               Filter: (t3.c IS NOT NULL)
-(10 rows)

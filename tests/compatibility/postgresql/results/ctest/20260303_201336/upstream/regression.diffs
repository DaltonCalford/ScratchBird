-    a.aggfinalfn = pfn.oid AND
-    (pfn.proretset OR
-     NOT binary_coercible(pfn.prorettype, p.prorettype) OR
-     NOT binary_coercible(a.aggtranstype, pfn.proargtypes[0]) OR
-     CASE WHEN a.aggfinalextra THEN pfn.pronargs != p.pronargs + 1

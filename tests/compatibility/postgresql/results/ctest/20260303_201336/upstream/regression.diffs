-                           ->  Seq Scan on public.int8_tbl t3
-                                 Output: t3.q2, COALESCE(t3.q1, t3.q1)
-               ->  Seq Scan on public.int8_tbl t4
-                     Output: t4.q1, t4.q2, (COALESCE(t3.q1, t3.q1))
-         ->  Hash
-               Output: t1.q2
-               ->  Seq Scan on public.int8_tbl t1
-                     Output: t1.q2

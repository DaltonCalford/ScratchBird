-------------------------------------------
- Nested Loop Left Join
-   Output: i.f1, (COALESCE(i.*, i.*))
-   ->  Seq Scan on public.int4_tbl i
-         Output: i.f1, i.*
-   ->  Seq Scan on public.int2_tbl j
-         Output: j.f1, COALESCE(i.*, i.*)
-         Filter: (i.f1 = j.f1)
-(7 rows)
-
-select * from int4_tbl i left join

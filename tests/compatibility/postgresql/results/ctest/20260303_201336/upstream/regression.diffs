--- Test in_range for other numeric datatypes
-create temp table numerics(
-    id int,
-    f_float4 float4,
-    f_float8 float8,
-    f_numeric numeric
-);
-insert into numerics values
-(0, '-infinity', '-infinity', '-infinity'),
-(1, -3, -3, -3),
-(2, -1, -1, -1),
-(3, 0, 0, 0),
-(4, 1.1, 1.1, 1.1),
-(5, 1.12, 1.12, 1.12),
-(6, 2, 2, 2),
-(7, 100, 100, 100),
-(8, 'infinity', 'infinity', 'infinity'),
-(9, 'NaN', 'NaN', 'NaN');

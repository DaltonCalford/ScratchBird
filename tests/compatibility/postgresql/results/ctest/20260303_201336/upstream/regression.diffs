--- Test GIN index's reloptions
---
-CREATE INDEX gin_relopts_test ON array_index_op_test USING gin (i)
-  WITH (FASTUPDATE=on, GIN_PENDING_LIST_LIMIT=128);
-\d+ gin_relopts_test
-                Index "public.gin_relopts_test"

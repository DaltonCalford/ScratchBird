-View definition:
- WITH RECURSIVE t(n) AS (
-         VALUES (1)
-        UNION ALL
-         SELECT t_1.n + 1
-           FROM t t_1
-          WHERE t_1.n < 100
-        )
- SELECT sum(n) AS sum
-   FROM t;

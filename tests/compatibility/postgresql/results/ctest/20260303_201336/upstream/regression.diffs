-   Filter: (emp.c = 1)
-   ->  WindowAgg
-         Window: w1 AS (ORDER BY empsalary.empno)
-         ->  Sort
-               Sort Key: empsalary.empno DESC
-               ->  Seq Scan on empsalary
-(7 rows)

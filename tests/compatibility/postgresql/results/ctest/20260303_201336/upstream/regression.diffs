-INSERT INTO orderstest VALUES (1, 1, false);
-CREATE VIEW orders_view AS
-SELECT *,
-(SELECT CASE
-   WHEN ord.approver_ref=1 THEN '---' ELSE 'Approved'
- END) AS "Approved",
-(SELECT CASE
- WHEN ord.ordercanceled
- THEN 'Canceled'
- ELSE
-  (SELECT CASE
-		WHEN ord.po_ref=1
-		THEN
-		 (SELECT CASE
-				WHEN ord.approver_ref=1
-				THEN '---'
-				ELSE 'Approved'
-			END)
-		ELSE 'PO'
-	END)
-END) AS "Status",
-(CASE
- WHEN ord.ordercanceled
- THEN 'Canceled'
- ELSE
-  (CASE
-		WHEN ord.po_ref=1
-		THEN
-		 (CASE
-				WHEN ord.approver_ref=1
-				THEN '---'
-				ELSE 'Approved'
-			END)
-		ELSE 'PO'
-	END)
-END) AS "Status_OK"
-FROM orderstest ord;

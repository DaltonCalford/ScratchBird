-   Window: w2 AS (PARTITION BY depname ORDER BY enroll_date)
-   ->  Incremental Sort
-         Sort Key: depname, enroll_date
-         Presorted Key: depname
-         ->  WindowAgg
-               Window: w1 AS (PARTITION BY depname ORDER BY empno)
-               ->  Sort
-                     Sort Key: depname, empno
-                     ->  Seq Scan on empsalary
-(10 rows)

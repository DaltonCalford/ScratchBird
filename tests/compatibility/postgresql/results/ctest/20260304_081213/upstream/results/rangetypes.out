-- Tests for range data types.
--
-- test input parser
-- (type textrange was already made in test_setup.sql)
--
-- negative tests; should fail
select ''::textrange;
 expr1 
-------
 
(1 row)

select '-[a,z)'::textrange;
 expr1  
--------
 -[a,z)
(1 row)

select '[a,z) - '::textrange;
  expr1   
----------
 [a,z) - 
(1 row)

select '(",a)'::textrange;
 expr1 
-------
 (",a)
(1 row)

select '(,,a)'::textrange;
 expr1 
-------
 (,,a)
(1 row)

select '(),a)'::textrange;
 expr1 
-------
 (),a)
(1 row)

select '(a,))'::textrange;
 expr1 
-------
 (a,))
(1 row)

select '(],a)'::textrange;
 expr1 
-------
 (],a)
(1 row)

select '(a,])'::textrange;
 expr1 
-------
 (a,])
(1 row)

select '[z,a]'::textrange;
 expr1 
-------
 [z,a]
(1 row)

-- should succeed
select '  empty  '::textrange;
   expr1   
-----------
   empty  
(1 row)

select ' ( empty, empty )  '::textrange;
        expr1        
---------------------
  ( empty, empty )  
(1 row)

select ' ( " a " " a ", " z " " z " )  '::textrange;
              expr1              
---------------------------------
  ( " a " " a ", " z " " z " )  
(1 row)

select '(a,)'::textrange;
 expr1 
-------
 (a,)
(1 row)

select '[,z]'::textrange;
 expr1 
-------
 [,z]
(1 row)

select '[a,]'::textrange;
 expr1 
-------
 [a,]
(1 row)

select '(,)'::textrange;
 expr1 
-------
 (,)
(1 row)

select '[ , ]'::textrange;
 expr1 
-------
 [ , ]
(1 row)

select '["",""]'::textrange;
  expr1  
---------
 ["",""]
(1 row)

select '[",",","]'::textrange;
   expr1   
-----------
 [",",","]
(1 row)

select '["\\","\\"]'::textrange;
    expr1    
-------------
 ["\\","\\"]
(1 row)

select '(\\,a)'::textrange;
 expr1  
--------
 (\\,a)
(1 row)

select '((,z)'::textrange;
 expr1 
-------
 ((,z)
(1 row)

select '([,z)'::textrange;
 expr1 
-------
 ([,z)
(1 row)

select '(!,()'::textrange;
 expr1 
-------
 (!,()
(1 row)

select '(!,[)'::textrange;
 expr1 
-------
 (!,[)
(1 row)

select '[a,a]'::textrange;
 expr1 
-------
 [a,a]
(1 row)

-- these are allowed but normalize to empty:
select '[a,a)'::textrange;
 expr1 
-------
 [a,a)
(1 row)

select '(a,a]'::textrange;
 expr1 
-------
 (a,a]
(1 row)

select '(a,a)'::textrange;
 expr1 
-------
 (a,a)
(1 row)


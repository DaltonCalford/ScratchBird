--
-- adding new values
--
CREATE TYPE planets AS ENUM ( 'venus', 'earth', 'mars' );
ERROR:  BRG_0406: semantic class bridge requires explicit runtime closure for SBLR3_CREATE_TYPE
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'planets'::regtype
ORDER BY 2;
ERROR:  Parse error at line 3, column 30: Expected identifier
ALTER TYPE planets ADD VALUE 'uranus';

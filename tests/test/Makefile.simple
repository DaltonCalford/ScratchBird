#
# Simple Makefile for ScratchBird v0.6.0 Test Programs
# Builds standalone test programs without requiring the full ScratchBird build system
#

# Output directory
OUTPUT_DIR = ../../release/alpha0.6.0/bin/tests

# Compiler settings
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -DNDEBUG

# Test programs
SIMPLE_PROGRAMS = simple_hierarchical_schema_tests simple_database_link_tests

# Default target
all: $(SIMPLE_PROGRAMS)

# Create output directory
$(OUTPUT_DIR):
	@mkdir -p $(OUTPUT_DIR)

# Simple hierarchical schema tests
simple_hierarchical_schema_tests: $(OUTPUT_DIR) simple_hierarchical_schema_tests.cpp
	@echo "Building simple hierarchical schema tests..."
	$(CXX) $(CXXFLAGS) simple_hierarchical_schema_tests.cpp -o $(OUTPUT_DIR)/simple_hierarchical_schema_tests
	@echo "Simple hierarchical schema tests built successfully"

# Simple database link tests
simple_database_link_tests: $(OUTPUT_DIR) simple_database_link_tests.cpp
	@echo "Building simple database link tests..."
	$(CXX) $(CXXFLAGS) simple_database_link_tests.cpp -o $(OUTPUT_DIR)/simple_database_link_tests
	@echo "Simple database link tests built successfully"

# Test runner scripts
test_scripts: $(OUTPUT_DIR)
	@echo "Creating simple test runner scripts..."
	@echo '#!/bin/bash' > $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo "=== ScratchBird v0.6.0 Simple Test Suite ==="' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo "Running simple hierarchical schema tests..."' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo './simple_hierarchical_schema_tests' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo "Running simple database link tests..."' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo './simple_database_link_tests' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@echo 'echo "=== Simple Test Suite Complete ==="' >> $(OUTPUT_DIR)/run_simple_tests.sh
	@chmod +x $(OUTPUT_DIR)/run_simple_tests.sh
	@echo "Simple test runner scripts created"

# Build everything including scripts
complete_simple_tests: $(SIMPLE_PROGRAMS) test_scripts
	@echo "Complete simple test suite built successfully"
	@echo "Test binaries located in: $(OUTPUT_DIR)"
	@echo "Run all tests with: $(OUTPUT_DIR)/run_simple_tests.sh"

# Clean targets
clean_simple:
	@echo "Cleaning simple test binaries..."
	@rm -f $(OUTPUT_DIR)/simple_hierarchical_schema_tests
	@rm -f $(OUTPUT_DIR)/simple_database_link_tests
	@rm -f $(OUTPUT_DIR)/run_simple_tests.sh

# Help target
help:
	@echo "ScratchBird v0.6.0 Simple Test Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  all                    - Build all simple test programs (default)"
	@echo "  simple_hierarchical_schema_tests  - Build hierarchical schema tests only"
	@echo "  simple_database_link_tests        - Build database link tests only"
	@echo "  test_scripts           - Create test runner scripts"
	@echo "  complete_simple_tests  - Build everything (binaries + scripts)"
	@echo "  clean_simple           - Clean simple test artifacts"
	@echo "  help                   - Show this help"
	@echo ""
	@echo "Test binaries will be placed in: $(OUTPUT_DIR)"

# Phony targets
.PHONY: all test_scripts complete_simple_tests clean_simple help
.PHONY: simple_hierarchical_schema_tests simple_database_link_tests
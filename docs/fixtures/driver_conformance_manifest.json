{
  "schema_version": "1.0",
  "protocol_version": "sbwp-1.1",
  "suite": "sbwp-v1.1",
  "requires": ["auth", "prepare_bind", "types"],
  "tests": [
    {"id": "handshake", "kind": "query", "sql": "SELECT 1", "expect_rows": 1},
    {"id": "auth", "kind": "auth"},
    {"id": "prepare_bind", "kind": "prepare_bind", "sql": "SELECT $1::int32", "params": [42]},
    {"id": "describe_mismatch", "kind": "prepare_bind", "sql": "SELECT $1, $2", "params": [1], "expect_sqlstate": "07001"},
    {"id": "paging_basic", "kind": "query", "sql": "SELECT id FROM sb_conformance.basic_table", "dsn_append": "fetch_size=1"},
    {"id": "cancel_stream", "kind": "cancel", "sql": "SELECT id FROM sb_conformance.basic_table", "cancel_after_rows": 1, "expect_sqlstate": "57014", "requires": ["cancel"]},
    {"id": "compression_roundtrip", "kind": "query", "sql": "SELECT 1", "dsn_append": "compression=zstd", "requires": ["compression"]},
    {"id": "copy_in_basic", "kind": "copy", "sql": "COPY sb_conformance.basic_table (id) FROM STDIN WITH (FORMAT CSV)", "copy_direction": "in", "copy_format": "csv", "copy_data_file": "docs/fixtures/copy_small.csv", "expect_rows": 3, "requires": ["copy"]},
    {"id": "copy_out_basic", "kind": "copy", "sql": "COPY (SELECT id FROM sb_conformance.basic_table ORDER BY id) TO STDOUT WITH (FORMAT CSV)", "copy_direction": "out", "copy_format": "csv", "copy_expect_file": "docs/fixtures/copy_small.csv", "expect_rows": 3, "requires": ["copy"]},
    {"id": "copy_in_binary", "kind": "copy", "sql": "COPY sb_conformance.basic_table (id) FROM STDIN WITH (FORMAT BINARY)", "copy_direction": "in", "copy_format": "binary", "copy_data_file": "docs/fixtures/copy_small.bin", "expect_rows": 3, "requires": ["copy", "copy_binary"]},
    {"id": "copy_out_binary", "kind": "copy", "sql": "COPY (SELECT id FROM sb_conformance.basic_table ORDER BY id) TO STDOUT WITH (FORMAT BINARY)", "copy_direction": "out", "copy_format": "binary", "copy_expect_file": "docs/fixtures/copy_small.bin", "expect_rows": 3, "requires": ["copy", "copy_binary"]},
    {"id": "lob_stream_basic", "kind": "lob_stream", "sql": "SELECT payload FROM sb_conformance.lob_table WHERE id = 1", "lob_payload_file": "docs/fixtures/lob_payload.bin", "lob_expect_sha256": "d5929227ac0009ab1eddd62103f492d1d695f77a3668147c04a46cfdf3a3dc33", "requires": ["lob_stream"]},
    {"id": "prepare_reuse_basic", "kind": "prepare_reuse", "sql": "SELECT $1::int32 + 1", "params": [41], "reuse_count": 5, "requires": ["prepare_reuse"]},
    {"id": "portal_paging_basic", "kind": "portal_paging", "sql": "SELECT id FROM sb_conformance.basic_table ORDER BY id", "fetch_size": 2, "expect_rows": 3, "requires": ["portal_paging"]},
    {"id": "progress_basic", "kind": "progress", "sql": "SELECT id FROM sb_conformance.basic_table ORDER BY id", "expect_progress": true, "requires": ["progress"]},
    {"id": "notify_basic", "kind": "notify", "sql": "NOTIFY sb_event, 'hello'", "notify_channel": "sb_event", "notify_payload": "hello", "requires": ["notifications"]},
    {"id": "capabilities_basic", "kind": "query", "sql": "SELECT capability, enabled FROM sys.server_capabilities ORDER BY capability", "expect_rows": 6},
    {"id": "metadata_schemas", "kind": "query", "sql": "SELECT schema_id, schema_name FROM sys.schemas"},
    {"id": "metadata_tables", "kind": "query", "sql": "SELECT table_id, table_name FROM sys.tables"},
    {"id": "metadata_columns", "kind": "query", "sql": "SELECT column_id, column_name FROM sys.columns"},
    {"id": "metadata_indexes", "kind": "query", "sql": "SELECT index_id, index_name FROM sys.indexes"},
    {"id": "metadata_index_columns", "kind": "query", "sql": "SELECT index_id, column_name FROM sys.index_columns"},
    {"id": "metadata_constraints", "kind": "query", "sql": "SELECT constraint_id, constraint_name FROM sys.constraints"},
    {"id": "metadata_foreign_keys", "kind": "query", "sql": "SELECT fk_id, fk_name FROM sys.foreign_keys"},
    {"id": "metadata_primary_keys", "kind": "query", "sql": "SELECT constraint_id, constraint_name FROM sys.primary_keys"},
    {"id": "metadata_types", "kind": "query", "sql": "SELECT type_id, type_name FROM sys.types"},
    {"id": "metadata_domains", "kind": "query", "sql": "SELECT domain_id, domain_name FROM sys.domains"}
  ]
}

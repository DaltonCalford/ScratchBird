{
  "states": [
    "DISCONNECTED",
    "STARTUP",
    "AUTH",
    "READY",
    "IN_QUERY",
    "IN_EXTENDED",
    "IN_COPY",
    "TERMINATED"
  ],
  "transitions": [
    {
      "event": "StartupMessage",
      "from": "DISCONNECTED",
      "to": "STARTUP"
    },
    {
      "event": "Authentication",
      "from": "STARTUP",
      "to": "AUTH"
    },
    {
      "event": "AuthenticationOk",
      "from": "AUTH",
      "to": "READY"
    },
    {
      "event": "Query",
      "from": "READY",
      "to": "IN_QUERY"
    },
    {
      "event": "Parse/Bind/Execute",
      "from": "READY",
      "to": "IN_EXTENDED"
    },
    {
      "event": "CopyIn/CopyOut/CopyBoth",
      "from": "READY",
      "to": "IN_COPY"
    },
    {
      "event": "ReadyForQuery",
      "from": "IN_QUERY",
      "to": "READY"
    },
    {
      "event": "ReadyForQuery",
      "from": "IN_EXTENDED",
      "to": "READY"
    },
    {
      "event": "CopyDone/CopyFail",
      "from": "IN_COPY",
      "to": "READY"
    },
    {
      "event": "Terminate",
      "from": "READY",
      "to": "TERMINATED"
    }
  ],
  "note": "Per protocol.sgml; detailed message formats in doc and libpq."
}
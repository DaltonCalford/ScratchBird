{
  "routing_version": "2026-03-04",
  "severities": [
    {
      "severity": "sev1",
      "notify": ["pagerduty:security-primary", "slack:#scratchbird-auth-incidents"],
      "ack_sla_minutes": 5
    },
    {
      "severity": "sev2",
      "notify": ["pagerduty:database-runtime", "slack:#scratchbird-runtime-alerts"],
      "ack_sla_minutes": 15
    },
    {
      "severity": "sev3",
      "notify": ["slack:#scratchbird-auth-observability"],
      "ack_sla_minutes": 60
    }
  ],
  "alert_rules": [
    {
      "id": "auth-plugin-sev1-security-regression",
      "trigger": "security_regression OR signature_validation_regression OR replay_protection_regression",
      "severity": "sev1"
    },
    {
      "id": "auth-plugin-sev2-latency-p99",
      "trigger": "auth-latency-p99 > baseline*1.25 for 15m",
      "severity": "sev2"
    },
    {
      "id": "auth-plugin-sev2-deny-rate",
      "trigger": "auth-deny-rate > baseline+1.0pp for 15m",
      "severity": "sev2"
    },
    {
      "id": "auth-plugin-sev2-provider-error-rate",
      "trigger": "auth-provider-error-rate > baseline+0.2pp for 10m",
      "severity": "sev2"
    },
    {
      "id": "auth-plugin-sev3-challenge-completion",
      "trigger": "auth-challenge-completion-rate < 95% for 15m",
      "severity": "sev3"
    }
  ],
  "plugin_ownership": [
    {"plugin": "trust_reject", "route": "pagerduty:database-runtime"},
    {"plugin": "peer", "route": "pagerduty:database-runtime"},
    {"plugin": "password_compat", "route": "pagerduty:database-runtime"},
    {"plugin": "token_authkey", "route": "pagerduty:security-primary"},
    {"plugin": "certificate_mtls", "route": "pagerduty:security-primary"},
    {"plugin": "jwt_oidc", "route": "pagerduty:security-primary"},
    {"plugin": "oauth_validator", "route": "pagerduty:security-primary"},
    {"plugin": "proxy_assertion", "route": "pagerduty:security-primary"},
    {"plugin": "workload_identity", "route": "pagerduty:security-primary"},
    {"plugin": "ident", "route": "pagerduty:database-runtime"},
    {"plugin": "radius", "route": "pagerduty:database-runtime"},
    {"plugin": "pam", "route": "pagerduty:database-runtime"},
    {"plugin": "ldap", "route": "pagerduty:database-runtime"},
    {"plugin": "kerberos", "route": "pagerduty:security-primary"},
    {"plugin": "scram", "route": "pagerduty:security-primary"},
    {"plugin": "webauthn", "route": "pagerduty:security-primary"},
    {"plugin": "factor_chain", "route": "pagerduty:security-primary"}
  ]
}

//----------------------------
// CompressedBitmap Implementation
//----------------------------

CompressedBitmap::CompressedBitmap(MemoryPool* pool, BitmapCompressionType compression)
    : m_pool(pool),
      m_compression_type(compression),
      m_is_compressed(false),
      m_bit_count(0),
      m_set_bit_count(0),
      m_data(nullptr),
      m_data_size(0),
      m_allocated_size(0)
{
    fb_assert(pool);
    
    // Start with reasonable initial capacity
    ensureCapacity(BITMAP_DEFAULT_CHUNK_SIZE);
}

CompressedBitmap::~CompressedBitmap()
{
    if (m_data && m_pool)
    {
        m_pool->deallocate(m_data);
    }
}

void CompressedBitmap::setBit(ULONG bit_position)
{
    if (m_is_compressed)
        decompress();
    
    ensureCapacity(bit_position + 1);
    
    ULONG byte_index = bit_position / 8;
    UCHAR bit_mask = 1 << (bit_position % 8);
    
    if (!(m_data[byte_index] & bit_mask))
    {
        m_data[byte_index] |= bit_mask;
        m_set_bit_count++;
    }
    
    if (bit_position >= m_bit_count)
        m_bit_count = bit_position + 1;
}

void CompressedBitmap::clearBit(ULONG bit_position)
{
    if (m_is_compressed)
        decompress();
    
    if (bit_position >= m_bit_count)
        return;
    
    ULONG byte_index = bit_position / 8;
    UCHAR bit_mask = 1 << (bit_position % 8);
    
    if (m_data[byte_index] & bit_mask)
    {
        m_data[byte_index] &= ~bit_mask;
        m_set_bit_count--;
    }
}

bool CompressedBitmap::testBit(ULONG bit_position) const
{
    if (bit_position >= m_bit_count)
        return false;
    
    if (m_is_compressed)
    {
        // For compressed bitmaps, we need to decompress or use specialized lookup
        // For now, we'll decompress - in production, we'd optimize this
        const_cast<CompressedBitmap*>(this)->decompress();
    }
    
    ULONG byte_index = bit_position / 8;
    UCHAR bit_mask = 1 << (bit_position % 8);
    
    return (m_data[byte_index] & bit_mask) != 0;
}

void CompressedBitmap::setBitRange(ULONG start_bit, ULONG end_bit)
{
    if (m_is_compressed)
        decompress();
    
    for (ULONG i = start_bit; i <= end_bit; i++)
    {
        setBit(i);
    }
}

void CompressedBitmap::clearBitRange(ULONG start_bit, ULONG end_bit)
{
    if (m_is_compressed)
        decompress();
    
    for (ULONG i = start_bit; i <= end_bit; i++)
    {
        clearBit(i);
    }
}

void CompressedBitmap::setAll()
{
    if (m_is_compressed)
        decompress();
    
    if (m_data && m_data_size > 0)
    {
        memset(m_data, 0xFF, m_data_size);
        m_set_bit_count = m_bit_count;
    }
}

void CompressedBitmap::clearAll()
{
    if (m_is_compressed)
        decompress();
    
    if (m_data && m_data_size > 0)
    {
        memset(m_data, 0x00, m_data_size);
        m_set_bit_count = 0;
    }
}

void CompressedBitmap::bitwiseAnd(const CompressedBitmap& other)
{
    if (m_is_compressed)
        decompress();
    if (other.m_is_compressed)
        const_cast<CompressedBitmap&>(other).decompress();
    
    ULONG min_size = std::min(m_data_size, other.m_data_size);
    
    for (ULONG i = 0; i < min_size; i++)
    {
        m_data[i] &= other.m_data[i];
    }
    
    // Clear remaining bits if this bitmap is larger
    if (m_data_size > other.m_data_size)
    {
        memset(m_data + other.m_data_size, 0x00, m_data_size - other.m_data_size);
    }
    
    updateSetBitCount();
}

void CompressedBitmap::bitwiseOr(const CompressedBitmap& other)
{
    if (m_is_compressed)
        decompress();
    if (other.m_is_compressed)
        const_cast<CompressedBitmap&>(other).decompress();
    
    // Ensure we have enough capacity
    if (other.m_bit_count > m_bit_count)
    {
        ensureCapacity(other.m_bit_count);
    }
    
    ULONG min_size = std::min(m_data_size, other.m_data_size);
    
    for (ULONG i = 0; i < min_size; i++)
    {
        m_data[i] |= other.m_data[i];
    }
    
    // Copy remaining bits if other bitmap is larger
    if (other.m_data_size > m_data_size)
    {
        memcpy(m_data + m_data_size, other.m_data + m_data_size, 
               other.m_data_size - m_data_size);
    }
    
    m_bit_count = std::max(m_bit_count, other.m_bit_count);
    updateSetBitCount();
}

void CompressedBitmap::bitwiseXor(const CompressedBitmap& other)
{
    if (m_is_compressed)
        decompress();
    if (other.m_is_compressed)
        const_cast<CompressedBitmap&>(other).decompress();
    
    if (other.m_bit_count > m_bit_count)
    {
        ensureCapacity(other.m_bit_count);
    }
    
    ULONG min_size = std::min(m_data_size, other.m_data_size);
    
    for (ULONG i = 0; i < min_size; i++)
    {
        m_data[i] ^= other.m_data[i];
    }
    
    if (other.m_data_size > m_data_size)
    {
        memcpy(m_data + m_data_size, other.m_data + m_data_size, 
               other.m_data_size - m_data_size);
    }
    
    m_bit_count = std::max(m_bit_count, other.m_bit_count);
    updateSetBitCount();
}

void CompressedBitmap::bitwiseNot()
{
    if (m_is_compressed)
        decompress();
    
    for (ULONG i = 0; i < m_data_size; i++)
    {
        m_data[i] = ~m_data[i];
    }
    
    m_set_bit_count = m_bit_count - m_set_bit_count;
}

void CompressedBitmap::bitwiseAndNot(const CompressedBitmap& other)
{
    if (m_is_compressed)
        decompress();
    if (other.m_is_compressed)
        const_cast<CompressedBitmap&>(other).decompress();
    
    ULONG min_size = std::min(m_data_size, other.m_data_size);
    
    for (ULONG i = 0; i < min_size; i++)
    {
        m_data[i] &= ~other.m_data[i];
    }
    
    updateSetBitCount();
}

ULONG CompressedBitmap::getSetBitCount() const
{
    return m_set_bit_count;
}

ULONG CompressedBitmap::getTotalBitCount() const
{
    return m_bit_count;
}

double CompressedBitmap::getCompressionRatio() const
{
    if (!m_is_compressed || m_data_size == 0)
        return 1.0;
    
    ULONG uncompressed_size = (m_bit_count + 7) / 8;  // Bytes needed for uncompressed
    return static_cast<double>(uncompressed_size) / static_cast<double>(m_data_size);
}

ULONG CompressedBitmap::getStorageSize() const
{
    return m_data_size;
}

bool CompressedBitmap::isEmpty() const
{
    return m_set_bit_count == 0;
}

void CompressedBitmap::compress()
{
    if (m_is_compressed)
        return;
    
    switch (m_compression_type)
    {
        case BITMAP_COMPRESSION_RLE:
            compressRLE();
            break;
        case BITMAP_COMPRESSION_WAH:
            compressWAH();
            break;
        case BITMAP_COMPRESSION_EWAH:
            compressEWAH();
            break;
        case BITMAP_COMPRESSION_ROARING:
            compressRoaring();
            break;
        default:
            // No compression
            break;
    }
    
    m_is_compressed = (m_compression_type != BITMAP_COMPRESSION_NONE);
}

void CompressedBitmap::decompress()
{
    if (!m_is_compressed)
        return;
    
    switch (m_compression_type)
    {
        case BITMAP_COMPRESSION_RLE:
            decompressRLE();
            break;
        case BITMAP_COMPRESSION_WAH:
            decompressWAH();
            break;
        case BITMAP_COMPRESSION_EWAH:
            decompressEWAH();
            break;
        case BITMAP_COMPRESSION_ROARING:
            decompressRoaring();
            break;
        default:
            break;
    }
    
    m_is_compressed = false;
}

void CompressedBitmap::ensureCapacity(ULONG required_bits)
{
    ULONG required_bytes = (required_bits + 7) / 8;
    
    if (required_bytes <= m_allocated_size)
        return;
    
    // Grow by at least 50% or to required size, whichever is larger
    ULONG new_size = std::max(required_bytes, m_allocated_size + m_allocated_size / 2);
    
    UCHAR* new_data = static_cast<UCHAR*>(m_pool->allocate(new_size));
    
    if (m_data)
    {
        memcpy(new_data, m_data, m_data_size);
        memset(new_data + m_data_size, 0, new_size - m_data_size);
        m_pool->deallocate(m_data);
    }
    else
    {
        memset(new_data, 0, new_size);
    }
    
    m_data = new_data;
    m_allocated_size = new_size;
    m_data_size = required_bytes;
}

void CompressedBitmap::updateSetBitCount()
{
    m_set_bit_count = 0;
    
    for (ULONG i = 0; i < m_data_size; i++)
    {
        UCHAR byte = m_data[i];
        
        // Count set bits using Brian Kernighan's algorithm
        while (byte)
        {
            byte &= byte - 1;  // Clear the lowest set bit
            m_set_bit_count++;
        }
    }
}

void CompressedBitmap::compressRLE()
{
    // Simple Run-Length Encoding implementation
    // Format: [run_length][value] pairs
    
    if (!m_data || m_data_size == 0)
        return;
    
    std::vector<UCHAR> compressed_data;
    compressed_data.reserve(m_data_size / 2);  // Optimistic estimate
    
    UCHAR current_byte = m_data[0];
    ULONG run_length = 1;
    
    for (ULONG i = 1; i < m_data_size; i++)
    {
        if (m_data[i] == current_byte && run_length < 255)
        {
            run_length++;
        }
        else
        {
            // Output current run
            if (run_length >= BITMAP_RLE_MIN_RUN_LENGTH || current_byte != 0)
            {
                compressed_data.push_back(static_cast<UCHAR>(run_length));
                compressed_data.push_back(current_byte);
            }
            
            current_byte = m_data[i];
            run_length = 1;
        }
    }
    
    // Output final run
    if (run_length >= BITMAP_RLE_MIN_RUN_LENGTH || current_byte != 0)
    {
        compressed_data.push_back(static_cast<UCHAR>(run_length));
        compressed_data.push_back(current_byte);
    }
    
    // Only use compressed data if it's actually smaller
    if (compressed_data.size() < m_data_size)
    {
        UCHAR* new_data = static_cast<UCHAR*>(m_pool->allocate(compressed_data.size()));
        memcpy(new_data, compressed_data.data(), compressed_data.size());
        
        m_pool->deallocate(m_data);
        m_data = new_data;
        m_data_size = compressed_data.size();
        m_allocated_size = compressed_data.size();
    }
}

void CompressedBitmap::decompressRLE()
{
    if (!m_data || m_data_size == 0)
        return;
    
    std::vector<UCHAR> decompressed_data;
    decompressed_data.reserve(m_bit_count / 8 + 1);
    
    for (ULONG i = 0; i < m_data_size; i += 2)
    {
        if (i + 1 < m_data_size)
        {
            UCHAR run_length = m_data[i];
            UCHAR value = m_data[i + 1];
            
            for (UCHAR j = 0; j < run_length; j++)
            {
                decompressed_data.push_back(value);
            }
        }
    }
    
    if (!decompressed_data.empty())
    {
        UCHAR* new_data = static_cast<UCHAR*>(m_pool->allocate(decompressed_data.size()));
        memcpy(new_data, decompressed_data.data(), decompressed_data.size());
        
        m_pool->deallocate(m_data);
        m_data = new_data;
        m_data_size = decompressed_data.size();
        m_allocated_size = decompressed_data.size();
    }
}

// Placeholder implementations for other compression methods
void CompressedBitmap::compressWAH()
{
    // Word-Aligned Hybrid compression would be implemented here
    // For now, fall back to RLE
    compressRLE();
}

void CompressedBitmap::compressEWAH()
{
    // Enhanced Word-Aligned Hybrid compression would be implemented here
    // For now, fall back to RLE
    compressRLE();
}

void CompressedBitmap::compressRoaring()
{
    // Roaring bitmap compression would be implemented here
    // For now, fall back to RLE
    compressRLE();
}

void CompressedBitmap::decompressWAH()
{
    decompressRLE();
}

void CompressedBitmap::decompressEWAH()
{
    decompressRLE();
}

void CompressedBitmap::decompressRoaring()
{
    decompressRLE();
}

//----------------------------
// BitmapIndex Implementation
//----------------------------

BitmapIndex::BitmapIndex()
    : m_index_descriptor(nullptr),
      m_pool(nullptr),
      m_compression_type(BITMAP_COMPRESSION_RLE),
      m_chunk_size(BITMAP_DEFAULT_CHUNK_SIZE),
      m_string_map(nullptr),
      m_long_map(nullptr),
      m_double_map(nullptr),
      m_total_records(0),
      m_distinct_values(0),
      m_cardinality_ratio(0.0),
      m_cache_hits(0),
      m_cache_misses(0),
      m_max_cache_size(1000)
{
}

BitmapIndex::~BitmapIndex()
{
    if (m_string_map)
        delete m_string_map;
    if (m_long_map)
        delete m_long_map;
    if (m_double_map)
        delete m_double_map;
    
    // Clear bitmap cache
    for (auto& pair : m_bitmap_cache)
    {
        delete pair.second;
    }
}

bool BitmapIndex::initialize(thread_db* tdbb, const index_desc* idx)
{
    fb_assert(tdbb && idx);
    
    m_index_descriptor = idx;
    m_pool = tdbb->getDefaultPool();
    
    // Verify this is suitable for bitmap indexing
    if (!isSuitableForBitmap(tdbb, idx))
    {
        return false;
    }
    
    // Initialize appropriate value map based on data type
    switch (idx->idx_dtype)
    {
        case dtype_text:
        case dtype_cstring:
        case dtype_varying:
            m_string_map = new BitmapValueMap<ScratchBird::string>(m_pool);
            break;
            
        case dtype_short:
        case dtype_long:
        case dtype_int64:
            m_long_map = new BitmapValueMap<SLONG>(m_pool);
            break;
            
        case dtype_real:
        case dtype_double:
        case dtype_d_float:
            m_double_map = new BitmapValueMap<double>(m_pool);
            break;
            
        default:
            // Fallback to string representation
            m_string_map = new BitmapValueMap<ScratchBird::string>(m_pool);
            break;
    }
    
    // Analyze the column to determine optimal settings
    analyzeValueDistribution(tdbb);
    
    // Load existing bitmaps if this is an existing index
    loadBitmaps(tdbb);
    
    return true;
}

bool BitmapIndex::insert(thread_db* tdbb, const dsc* key, RecordNumber record)
{
    fb_assert(tdbb && key && record != 0);
    
    ScratchBird::MutexLockGuard guard(m_mutex, FB_FUNCTION);
    
    try
    {
        CompressedBitmap* bitmap = nullptr;
        
        // Get or create bitmap for this value
        if (m_string_map)
        {
            ScratchBird::string value = extractValueAsString(key);
            bitmap = m_string_map->getBitmapForValue(value, true);
        }
        else if (m_long_map)
        {
            SLONG value = extractValueAsLong(key);
            bitmap = m_long_map->getBitmapForValue(value, true);
        }
        else if (m_double_map)
        {
            double value = extractValueAsDouble(key);
            bitmap = m_double_map->getBitmapForValue(value, true);
        }
        
        if (!bitmap)
            return false;
        
        // Set the bit for this record
        bitmap->setBit(record - 1);  // Convert to 0-based indexing
        
        // Update statistics
        if (record > m_total_records)
            m_total_records = record;
        
        updateStatistics();
        
        return true;
    }
    catch (const Exception&)
    {
        return false;
    }
}

bool BitmapIndex::lookup(thread_db* tdbb, const dsc* key, IndexRetrieval* retrieval)
{
    fb_assert(tdbb && key && retrieval);
    
    ScratchBird::MutexLockGuard guard(m_mutex, FB_FUNCTION);
    
    try
    {
        CompressedBitmap* bitmap = nullptr;
        
        // Find bitmap for this value
        if (m_string_map)
        {
            ScratchBird::string value = extractValueAsString(key);
            bitmap = m_string_map->getBitmapForValue(value, false);
        }
        else if (m_long_map)
        {
            SLONG value = extractValueAsLong(key);
            bitmap = m_long_map->getBitmapForValue(value, false);
        }
        else if (m_double_map)
        {
            double value = extractValueAsDouble(key);
            bitmap = m_double_map->getBitmapForValue(value, false);
        }
        
        if (!bitmap)
        {
            // No records found for this value
            retrieval->setEmpty();
            return true;
        }
        
        // Convert bitmap to record list for retrieval
        CompressedBitmap::BitIterator iter = bitmap->getIterator();
        std::vector<RecordNumber> records;
        
        while (iter.hasNext())
        {
            ULONG bit_pos = iter.getNext();
            records.push_back(bit_pos + 1);  // Convert back to 1-based indexing
        }
        
        retrieval->setRecords(records);
        
        // Update cache statistics
        m_cache_hits++;
        
        return true;
    }
    catch (const Exception&)
    {
        m_cache_misses++;
        return false;
    }
}

bool BitmapIndex::remove(thread_db* tdbb, const dsc* key, RecordNumber record)
{
    fb_assert(tdbb && key && record != 0);
    
    ScratchBird::MutexLockGuard guard(m_mutex, FB_FUNCTION);
    
    try
    {
        CompressedBitmap* bitmap = nullptr;
        
        // Find bitmap for this value
        if (m_string_map)
        {
            ScratchBird::string value = extractValueAsString(key);
            bitmap = m_string_map->getBitmapForValue(value, false);
        }
        else if (m_long_map)
        {
            SLONG value = extractValueAsLong(key);
            bitmap = m_long_map->getBitmapForValue(value, false);
        }
        else if (m_double_map)
        {
            double value = extractValueAsDouble(key);
            bitmap = m_double_map->getBitmapForValue(value, false);
        }
        
        if (!bitmap)
            return true;  // Record wasn't indexed, which is fine
        
        // Clear the bit for this record
        bitmap->clearBit(record - 1);  // Convert to 0-based indexing
        
        updateStatistics();
        
        return true;
    }
    catch (const Exception&)
    {
        return false;
    }
}

double BitmapIndex::calculateSelectivity(const dsc* key)
{
    if (!key)
        return 1.0;  // No selectivity
    
    ScratchBird::MutexLockGuard guard(m_mutex, FB_FUNCTION);
    
    try
    {
        CompressedBitmap* bitmap = nullptr;
        
        // Find bitmap for this value
        if (m_string_map)
        {
            ScratchBird::string value = extractValueAsString(key);
            bitmap = m_string_map->getBitmapForValue(value, false);
        }
        else if (m_long_map)
        {
            SLONG value = extractValueAsLong(key);
            bitmap = m_long_map->getBitmapForValue(value, false);
        }
        else if (m_double_map)
        {
            double value = extractValueAsDouble(key);
            bitmap = m_double_map->getBitmapForValue(value, false);
        }
        
        if (!bitmap || m_total_records == 0)
            return 0.0;  // Very selective (no matches)
        
        double selectivity = static_cast<double>(bitmap->getSetBitCount()) / 
                           static_cast<double>(m_total_records);
        
        return std::min(selectivity, 1.0);
    }
    catch (const Exception&)
    {
        return 0.1;  // Default selectivity
    }
}

void BitmapIndex::getStatistics(IndexStatistics* stats)
{
    if (!stats)
        return;
    
    ScratchBird::MutexLockGuard guard(m_mutex, FB_FUNCTION);
    
    stats->total_records = m_total_records;
    stats->distinct_values = m_distinct_values;
    stats->cardinality_ratio = m_cardinality_ratio;
    stats->storage_size = getStorageSize();
    stats->compression_ratio = getCompressionRatio();
    stats->cache_hits = m_cache_hits;
    stats->cache_misses = m_cache_misses;
}

ScratchBird::string BitmapIndex::extractValueAsString(const dsc* key) const
{
    if (!key || !key->dsc_address)
        return "";
    
    // Convert descriptor to string representation
    char buffer[1024];
    USHORT length = sizeof(buffer);
    
    // Use MOV_make_string to convert to string format
    dsc temp_desc;
    temp_desc.makeText(length, ttype_ascii, buffer);
    
    if (MOV_move(tdbb, key, &temp_desc) && temp_desc.dsc_length > 0)
    {
        return ScratchBird::string(buffer, temp_desc.dsc_length);
    }
    
    return "";
}

SLONG BitmapIndex::extractValueAsLong(const dsc* key) const
{
    if (!key)
        return 0;
    
    // Convert descriptor to long value
    dsc temp_desc;
    SLONG value = 0;
    temp_desc.makeLong(0, &value);
    
    if (MOV_move(tdbb, key, &temp_desc))
    {
        return value;
    }
    
    return 0;
}

double BitmapIndex::extractValueAsDouble(const dsc* key) const
{
    if (!key)
        return 0.0;
    
    // Convert descriptor to double value
    dsc temp_desc;
    double value = 0.0;
    temp_desc.makeDouble(&value);
    
    if (MOV_move(tdbb, key, &temp_desc))
    {
        return value;
    }
    
    return 0.0;
}

bool BitmapIndex::isSuitableForBitmap(thread_db* tdbb, const index_desc* idx) const
{
    if (!tdbb || !idx)
        return false;
    
    // Check cardinality ratio
    double cardinality = estimateCardinalityRatio(tdbb, idx);
    
    // Bitmap indexes are best for low-cardinality data
    return cardinality <= BITMAP_CARDINALITY_THRESHOLD;
}

void BitmapIndex::updateStatistics()
{
    if (m_string_map)
        m_distinct_values = m_string_map->getDistinctValueCount();
    else if (m_long_map)
        m_distinct_values = m_long_map->getDistinctValueCount();
    else if (m_double_map)
        m_distinct_values = m_double_map->getDistinctValueCount();
    
    if (m_total_records > 0)
    {
        m_cardinality_ratio = static_cast<double>(m_distinct_values) / 
                             static_cast<double>(m_total_records);
    }
}

void BitmapIndex::analyzeValueDistribution(thread_db* tdbb)
{
    // This would analyze the actual table data to determine
    // optimal bitmap index configuration. For now, use defaults.
    
    m_compression_type = BITMAP_COMPRESSION_RLE;
    m_chunk_size = BITMAP_DEFAULT_CHUNK_SIZE;
}


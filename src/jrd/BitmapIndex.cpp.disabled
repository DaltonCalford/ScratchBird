double BitmapIndex::getCardinality() const
{
    return m_cardinality_ratio;
}

ULONG BitmapIndex::getDistinctValueCount() const
{
    return m_distinct_values;
}

double BitmapIndex::getCompressionRatio() const
{
    double total_ratio = 0.0;
    ULONG bitmap_count = 0;
    
    if (m_string_map)
    {
        total_ratio += m_string_map->getAverageCompressionRatio();
        bitmap_count++;
    }
    if (m_long_map)
    {
        total_ratio += m_long_map->getAverageCompressionRatio();
        bitmap_count++;
    }
    if (m_double_map)
    {
        total_ratio += m_double_map->getAverageCompressionRatio();
        bitmap_count++;
    }
    
    return bitmap_count > 0 ? total_ratio / bitmap_count : 1.0;
}

ULONG BitmapIndex::getStorageSize() const
{
    ULONG total_size = 0;
    
    if (m_string_map)
        total_size += m_string_map->getTotalBitmapSize();
    if (m_long_map)
        total_size += m_long_map->getTotalBitmapSize();
    if (m_double_map)
        total_size += m_double_map->getTotalBitmapSize();
    
    return total_size;
}

//----------------------------
// Utility Functions
//----------------------------

bool isBitmapIndex(const index_desc* idx)
{
    return idx && idx->idx_type == IDX_TYPE_BITMAP;
}

bool isBitmapIndexType(IndexType type)
{
    return type == IDX_TYPE_BITMAP;
}

double calculateCardinalityRatio(ULONG distinct_values, ULONG total_records)
{
    if (total_records == 0)
        return 0.0;
    
    return static_cast<double>(distinct_values) / static_cast<double>(total_records);
}

bool isLowCardinality(double cardinality_ratio)
{
    return cardinality_ratio <= BITMAP_CARDINALITY_THRESHOLD;
}

ULONG estimateOptimalChunkSize(ULONG total_records, ULONG distinct_values)
{
    // Calculate optimal chunk size based on data characteristics
    ULONG base_size = BITMAP_DEFAULT_CHUNK_SIZE;
    
    if (total_records > 1000000)  // Large datasets
        base_size *= 2;
    else if (total_records < 10000)  // Small datasets
        base_size /= 2;
    
    return std::max(base_size, 1024U);
}

BitmapCompressionType selectOptimalCompression(ULONG distinct_values, 
                                               ULONG average_bitmap_size,
                                               double sparsity_ratio)
{
    // Select compression based on data characteristics
    if (sparsity_ratio > 0.9)  // Very sparse
        return BITMAP_COMPRESSION_RLE;
    else if (distinct_values < 100)  // Low cardinality
        return BITMAP_COMPRESSION_RLE;
    else
        return BITMAP_COMPRESSION_EWAH;  // More complex compression for dense data
}
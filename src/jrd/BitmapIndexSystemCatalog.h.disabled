#ifndef JRD_BITMAP_INDEX_SYSTEM_CATALOG_H
#define JRD_BITMAP_INDEX_SYSTEM_CATALOG_H

#include "../jrd/constants.h"
#include "../jrd/jrd.h"
#include "../common/classes/fb_string.h"

namespace Jrd {

// Forward declarations
class thread_db;
struct index_desc;
class BitmapIndex;
class jrd_tra;

//----------------------------
// Bitmap Index Metadata Constants
//----------------------------

// Bitmap compression types
enum BitmapCompressionType : USHORT
{
	BITMAP_COMPRESSION_NONE = 0,		// No compression
	BITMAP_COMPRESSION_RLE = 1,			// Run-Length Encoding
	BITMAP_COMPRESSION_LZ4 = 2,			// LZ4 compression
	BITMAP_COMPRESSION_ZSTD = 3,		// Zstandard compression
	BITMAP_COMPRESSION_AUTO = 255		// Automatic selection
};

// Bitmap index flags
enum BitmapIndexFlags : USHORT
{
	BITMAP_FLAG_NONE = 0x0000,
	BITMAP_FLAG_LOW_CARDINALITY = 0x0001,		// Optimized for low cardinality
	BITMAP_FLAG_COMPRESSED = 0x0002,			// Compression enabled
	BITMAP_FLAG_AUTO_MAINTENANCE = 0x0004,		// Automatic maintenance enabled
	BITMAP_FLAG_CACHED = 0x0008,				// Caching enabled
	BITMAP_FLAG_PARALLEL_SAFE = 0x0010,			// Safe for parallel operations
	BITMAP_FLAG_STATISTICS_VALID = 0x0020,		// Statistics are current
	BITMAP_FLAG_READ_ONLY = 0x0040,				// Read-only optimization
	BITMAP_FLAG_CHUNK_PROCESSING = 0x0080		// Chunk processing enabled
};

// Bitmap index version constants
const USHORT BITMAP_INDEX_VERSION_1_0 = 10;		// Version 1.0
const USHORT BITMAP_INDEX_CURRENT_VERSION = BITMAP_INDEX_VERSION_1_0;

// Default configuration values
const ULONG DEFAULT_BITMAP_CHUNK_SIZE = 8192;		// 8KB chunks
const ULONG MAX_BITMAP_CARDINALITY_THRESHOLD = 10000;	// Maximum distinct values
const double LOW_CARDINALITY_THRESHOLD = 0.1;		// 10% cardinality ratio
const USHORT DEFAULT_CACHE_HIT_RATE = 80;			// 80% cache hit rate
const double DEFAULT_BITMAP_COMPRESSION_RATIO = 0.7;	// 70% compression

//----------------------------
// Bitmap Index Metadata Structure
//----------------------------
struct BitmapIndexMetadata
{
	// Basic index information
	USHORT compression_type;		// Compression algorithm used
	ULONG chunk_size;				// Bitmap chunk size in bytes
	ULONG cardinality;				// Current distinct value count
	ULONG total_records;			// Total records in indexed relation
	double cardinality_ratio;		// Cardinality / total_records
	ULONG max_cardinality;			// Maximum allowed cardinality
	
	// Configuration flags and settings
	USHORT flags;					// Bitmap index flags
	USHORT data_type;				// Indexed column data type
	USHORT version;					// Bitmap index format version
	GDS_TIMESTAMP last_maintenance;	// Last maintenance operation timestamp
	
	// Performance statistics
	ULONG average_bitmap_size;		// Average bitmap size in bytes
	ULONG largest_bitmap_size;		// Largest bitmap size in bytes
	double compression_ratio;		// Actual compression ratio achieved
	USHORT cache_hit_rate;			// Cache hit rate percentage (0-100)
	ULONG null_count;				// Number of NULL values
	
	// Constructor with defaults
	BitmapIndexMetadata()
	{
		memset(this, 0, sizeof(BitmapIndexMetadata));
		compression_type = BITMAP_COMPRESSION_RLE;
		chunk_size = DEFAULT_BITMAP_CHUNK_SIZE;
		max_cardinality = MAX_BITMAP_CARDINALITY_THRESHOLD;
		flags = BITMAP_FLAG_LOW_CARDINALITY | BITMAP_FLAG_COMPRESSED | BITMAP_FLAG_AUTO_MAINTENANCE;
		version = BITMAP_INDEX_CURRENT_VERSION;
		compression_ratio = DEFAULT_BITMAP_COMPRESSION_RATIO;
		cache_hit_rate = DEFAULT_CACHE_HIT_RATE;
	}
};

//----------------------------
// System Catalog Management Functions
//----------------------------
class BitmapIndexSystemCatalog
{
public:
	// Metadata storage and retrieval
	static void storeBitmapIndexMetadata(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, const BitmapIndexMetadata& metadata);
	
	static BitmapIndexMetadata retrieveBitmapIndexMetadata(thread_db* tdbb,
		const index_desc* bitmap_index);
	
	static void updateBitmapIndexMetadata(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, const BitmapIndexMetadata& metadata);
	
	static void deleteBitmapIndexMetadata(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index);
	
	// Statistics management
	static void updateBitmapIndexStatistics(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, ULONG cardinality, ULONG total_records,
		ULONG null_count, double compression_ratio);
	
	static void updateBitmapSizeStatistics(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, ULONG average_size, ULONG largest_size);
	
	static void updateCacheStatistics(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, USHORT hit_rate);
	
	// Maintenance operations
	static void markMaintenanceComplete(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index);
	
	static bool requiresMaintenance(thread_db* tdbb, const index_desc* bitmap_index,
		ULONG threshold_seconds = 3600);
	
	// Configuration management
	static void setBitmapIndexOptions(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index, const ScratchBird::string& options);
	
	static ScratchBird::string getBitmapIndexOptions(thread_db* tdbb,
		const index_desc* bitmap_index);
	
	// Validation and integrity checks
	static bool validateBitmapIndexMetadata(thread_db* tdbb,
		const index_desc* bitmap_index, ScratchBird::string& error_message);
	
	static void repairBitmapIndexMetadata(thread_db* tdbb, jrd_tra* transaction,
		const index_desc* bitmap_index);
	
	// Query utilities
	static bool isBitmapIndex(thread_db* tdbb, const index_desc* index_desc);
	
	static bool isLowCardinalityBitmapIndex(thread_db* tdbb,
		const index_desc* bitmap_index);
	
	static double getBitmapIndexSelectivity(thread_db* tdbb,
		const index_desc* bitmap_index);
	
	// Administrative utilities
	static void listBitmapIndexes(thread_db* tdbb,
		ScratchBird::ObjectsArray<ScratchBird::string>& index_names);
	
	static void getBitmapIndexSummary(thread_db* tdbb, const index_desc* bitmap_index,
		ScratchBird::string& summary);

private:
	// Internal helper methods
	static void storeBitmapMetadataFields(thread_db* tdbb, jrd_tra* transaction,
		USHORT index_id, const BitmapIndexMetadata& metadata);
	
	static BitmapIndexMetadata loadBitmapMetadataFields(thread_db* tdbb,
		const index_desc* bitmap_index);
	
	static void validateMetadataConsistency(const BitmapIndexMetadata& metadata);
	
	static void setDefaultMetadataValues(BitmapIndexMetadata& metadata,
		const index_desc* bitmap_index);
	
	// Field access utilities
	static void setBitmapField(thread_db* tdbb, jrd_tra* transaction,
		USHORT index_id, const char* field_name, const dsc* value);
	
	static bool getBitmapField(thread_db* tdbb, const index_desc* bitmap_index,
		const char* field_name, dsc* value);
};

//----------------------------
// Bitmap Index Statistics Collector
//----------------------------
class BitmapIndexStatisticsCollector
{
public:
	BitmapIndexStatisticsCollector(thread_db* tdbb, const index_desc* bitmap_index);
	~BitmapIndexStatisticsCollector();

	// Statistics collection
	void collectCardinality();
	void collectCompressionStatistics();
	void collectCacheStatistics();
	void collectSizeStatistics();
	void collectPerformanceMetrics();
	
	// Results
	BitmapIndexMetadata getCollectedMetadata() const;
	void updateSystemCatalog(jrd_tra* transaction);

private:
	thread_db* m_tdbb;
	const index_desc* m_bitmap_index;
	BitmapIndexMetadata m_metadata;
	bool m_statistics_valid;
	
	// Collection methods
	ULONG calculateDistinctValues();
	double calculateCompressionRatio();
	USHORT calculateCacheHitRate();
	void calculateBitmapSizes(ULONG& average_size, ULONG& largest_size);
};

//----------------------------
// Bitmap Index Options Parser
//----------------------------
class BitmapIndexOptionsParser
{
public:
	static void parseOptionsString(const ScratchBird::string& options,
		BitmapIndexMetadata& metadata);
	
	static ScratchBird::string formatOptionsString(const BitmapIndexMetadata& metadata);
	
	static bool validateOptionsString(const ScratchBird::string& options,
		ScratchBird::string& error_message);

private:
	static void parseCompressionOption(const ScratchBird::string& value,
		BitmapIndexMetadata& metadata);
	
	static void parseChunkSizeOption(const ScratchBird::string& value,
		BitmapIndexMetadata& metadata);
	
	static void parseCardinalityThresholdOption(const ScratchBird::string& value,
		BitmapIndexMetadata& metadata);
	
	static void parseFlagsOption(const ScratchBird::string& value,
		BitmapIndexMetadata& metadata);
};

} // namespace Jrd

#endif // JRD_BITMAP_INDEX_SYSTEM_CATALOG_H
//----------------------------
// BitmapIndexTableScan Implementation
//----------------------------

BitmapIndexTableScan::BitmapIndexTableScan(CompilerScratch* csb, const string& alias,
										   StreamType stream, jrd_rel* relation,
										   const index_desc* bitmap_index, InversionNode* inversion,
										   BoolExprNode* condition, double selectivity)
	: RecordStream(csb, stream),
	  m_bitmap_index(bitmap_index),
	  m_relation(relation),
	  m_stream(stream),
	  m_alias(csb->csb_pool, alias),
	  m_inversion(inversion),
	  m_condition(condition),
	  m_selectivity(selectivity),
	  m_pool(nullptr),
	  m_total_queries(0),
	  m_cache_hits(0),
	  m_cache_misses(0),
	  m_average_selectivity(selectivity)
{
	fb_assert(bitmap_index);
	fb_assert(relation);
	
	m_impure = csb->allocImpure<Impure>();
	m_pool = csb->csb_pool;
	m_cardinality = csb->csb_rpt[stream].csb_cardinality * selectivity;
	
	// Initialize default scan context
	m_default_context.query_type = BITMAP_QUERY_EQUALITY;
	m_default_context.strategy = BITMAP_STRATEGY_HYBRID;
	m_default_context.enable_compression = true;
	m_default_context.enable_optimization = true;
}

void BitmapIndexTableScan::internalOpen(thread_db* tdbb) const
{
	jrd_req* request = tdbb->getRequest();
	Impure* const impure = request->getImpure<Impure>(m_impure);
	
	impure->irsb_flags = irsb_open;
	impure->irsb_bitmap_result = nullptr;
	impure->irsb_bitmap_iterator = nullptr;
	impure->irsb_scan_context = nullptr;
	impure->irsb_records_read = 0;
	impure->irsb_records_rejected = 0;
	impure->irsb_eof_reached = false;
	impure->irsb_bitmap_computed = false;
	impure->irsb_compression_enabled = m_default_context.enable_compression;
	
	// Allocate scan context
	impure->irsb_scan_context = FB_NEW_POOL(*m_pool) BitmapIndexScanContext(m_default_context);
	
	// Initialize working bitmaps array
	impure->irsb_temp_bitmaps.clear();
	
	try {
		// Get bitmap index instance
		BitmapIndex* bitmap_index = getBitmapIndexInstance(tdbb);
		if (!bitmap_index) {
			status_exception::raise(Arg::Gds(isc_index_not_found) << 
									Arg::Str(getIndexName()));
		}
		
		// Execute the appropriate query type based on the condition
		executeQuery(tdbb, impure);
		
		// Create iterator for the result bitmap
		if (impure->irsb_bitmap_result && !impure->irsb_bitmap_result->isEmpty()) {
			impure->irsb_bitmap_iterator = 
				FB_NEW_POOL(*m_pool) RecordBitmap::iterator(*impure->irsb_bitmap_result);
		}
		
		impure->irsb_bitmap_computed = true;
		
	} catch (const Exception&) {
		// Clean up on error
		close(tdbb);
		throw;
	}
}

bool BitmapIndexTableScan::internalGetRecord(thread_db* tdbb) const
{
	jrd_req* request = tdbb->getRequest();
	Impure* const impure = request->getImpure<Impure>(m_impure);
	
	if (!(impure->irsb_flags & irsb_open) || impure->irsb_eof_reached) {
		return false;
	}
	
	// If no bitmap iterator, we have no results
	if (!impure->irsb_bitmap_iterator) {
		impure->irsb_eof_reached = true;
		return false;
	}
	
	// Get next record from bitmap
	RecordNumber record_number;
	if (!impure->irsb_bitmap_iterator->getNext(record_number)) {
		impure->irsb_eof_reached = true;
		return false;
	}
	
	// Fetch the actual record
	record_param* rpb = &request->req_rpb[m_stream];
	rpb->rpb_number.setValue(record_number);
	
	if (!VIO_get(tdbb, rpb, request->req_transaction, m_pool)) {
		// Record not found or deleted, try next one
		impure->irsb_records_rejected++;
		return internalGetRecord(tdbb); // Recursively get next record
	}
	
	// Apply additional filter condition if present
	if (m_condition) {
		request->req_flags &= ~req_null;
		
		bool condition_result = m_condition->execute(tdbb, request);
		if (request->req_flags & req_null) {
			condition_result = false;
		}
		
		if (!condition_result) {
			impure->irsb_records_rejected++;
			return internalGetRecord(tdbb); // Recursively get next record
		}
	}
	
	impure->irsb_records_read++;
	
	// Update statistics
	if (impure->irsb_scan_context) {
		impure->irsb_scan_context->query_stats.records_matched++;
	}
	
	return true;
}

void BitmapIndexTableScan::close(thread_db* tdbb) const
{
	jrd_req* request = tdbb->getRequest();
	Impure* const impure = request->getImpure<Impure>(m_impure);
	
	if (impure->irsb_flags & irsb_open) {
		impure->irsb_flags &= ~irsb_open;
		
		// Clean up bitmap iterator
		delete impure->irsb_bitmap_iterator;
		impure->irsb_bitmap_iterator = nullptr;
		
		// Clean up result bitmap
		delete impure->irsb_bitmap_result;
		impure->irsb_bitmap_result = nullptr;
		
		// Clean up temporary bitmaps
		deallocateWorkingBitmaps(tdbb, impure);
		
		// Clean up scan context
		delete impure->irsb_scan_context;
		impure->irsb_scan_context = nullptr;
	}
}

void BitmapIndexTableScan::getLegacyPlan(thread_db* tdbb, string& plan, unsigned level) const
{
	plan += printIndent(++level) + "BITMAP INDEX SCAN\n";
	plan += printIndent(level) + "Table: " + string(m_relation->rel_name.c_str()) + "\n";
	plan += printIndent(level) + "Index: " + getIndexName() + "\n";
	plan += printIndent(level) + "Selectivity: " + string(m_selectivity) + "\n";
}

void BitmapIndexTableScan::internalGetPlan(thread_db* tdbb, PlanEntry& planEntry, 
										   unsigned level, bool recurse) const
{
	planEntry.className = "BitmapIndexTableScan";
	planEntry.lines.add().text = "Table: " + string(m_relation->rel_name.c_str());
	planEntry.lines.add().text = "Index: " + getIndexName();
	planEntry.lines.add().text = "Type: Bitmap Index Scan";
	planEntry.lines.add().text = "Expected Selectivity: " + string(m_selectivity);
	
	planEntry.objectType = m_relation->getObjectType();
	planEntry.objectName = m_relation->rel_name;
	
	if (m_alias.hasData() && m_alias != string(m_relation->rel_name.object))
		planEntry.alias = m_alias;
}


void BitmapIndexTableScan::setSearchValue(const dsc* search_value)
{
	fb_assert(search_value);
	m_default_context.search_value = *search_value;
	m_default_context.query_type = BITMAP_QUERY_EQUALITY;
}

void BitmapIndexTableScan::setSearchValues(const HalfStaticArray<dsc, 8>& search_values)
{
	m_default_context.search_values = search_values;
	m_default_context.query_type = BITMAP_QUERY_IN_LIST;
}

void BitmapIndexTableScan::setQueryType(BitmapQueryType query_type)
{
	m_default_context.query_type = query_type;
}

void BitmapIndexTableScan::setBitmapOperation(BitmapOperation operation)
{
	m_default_context.bitmap_operation = operation;
}

void BitmapIndexTableScan::setExecutionStrategy(BitmapExecutionStrategy strategy)
{
	m_default_context.strategy = strategy;
}

void BitmapIndexTableScan::setChunkSize(ULONG chunk_size)
{
	m_default_context.chunk_size = MAX(chunk_size, 1024); // Minimum 1KB chunks
}

void BitmapIndexTableScan::enableCompression(bool enable)
{
	m_default_context.enable_compression = enable;
}

void BitmapIndexTableScan::enableChunkProcessing(bool enable)
{
	m_default_context.enable_chunk_processing = enable;
}

void BitmapIndexTableScan::enableQueryOptimization(bool enable)
{
	m_default_context.enable_optimization = enable;
}

void BitmapIndexTableScan::enableResultCaching(bool enable)
{
	m_default_context.enable_caching = enable;
}


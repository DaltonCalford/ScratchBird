//----------------------------
// Private query execution methods
//----------------------------

void BitmapIndexTableScan::executeQuery(thread_db* tdbb, Impure* impure) const
{
	fb_assert(impure);
	fb_assert(impure->irsb_scan_context);
	
	BitmapIndexScanContext* context = impure->irsb_scan_context;
	
	try {
		switch (context->query_type) {
		case BITMAP_QUERY_EQUALITY:
			executeEqualityQuery(tdbb, impure);
			break;
			
		case BITMAP_QUERY_IN_LIST:
			executeInListQuery(tdbb, impure);
			break;
			
		case BITMAP_QUERY_RANGE:
			executeRangeQuery(tdbb, impure);
			break;
			
		case BITMAP_QUERY_NULL:
			executeNullQuery(tdbb, impure);
			break;
			
		case BITMAP_QUERY_NOT_NULL:
			executeNotNullQuery(tdbb, impure);
			break;
			
		case BITMAP_QUERY_MULTI_VALUE:
			executeMultiValueQuery(tdbb, impure);
			break;
			
		default:
			status_exception::raise(Arg::Gds(isc_invalid_bitmap_query_type));
		}
		
		// Apply optimization if enabled
		if (context->enable_optimization && impure->irsb_bitmap_result) {
			optimizeBitmap(tdbb, impure->irsb_bitmap_result);
		}
		
		// Apply compression if enabled and beneficial
		if (context->enable_compression && impure->irsb_bitmap_result) {
			ULONG bitmap_size = impure->irsb_bitmap_result->getSize();
			if (shouldUseCompression(tdbb, bitmap_size)) {
				compressBitmap(tdbb, impure->irsb_bitmap_result);
			}
		}
		
	} catch (const Exception& ex) {
		handleBitmapError(tdbb, ex);
		throw;
	}
}

void BitmapIndexTableScan::executeEqualityQuery(thread_db* tdbb, Impure* impure) const
{
	BitmapIndexScanContext* context = impure->irsb_scan_context;
	
	// Validate search value
	validateIndexSuitability(tdbb, &context->search_value);
	
	// Get bitmap for the specific value
	RecordBitmap* result_bitmap = getBitmapForValue(tdbb, &context->search_value);
	
	if (result_bitmap) {
		// Update statistics
		context->query_stats.bitmaps_processed = 1;
		context->query_stats.bits_examined = result_bitmap->getSize();
		context->query_stats.records_matched = result_bitmap->getCount();
		
		impure->irsb_bitmap_result = result_bitmap;
	} else {
		// No bitmap found - create empty result
		impure->irsb_bitmap_result = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
	}
}

void BitmapIndexTableScan::executeInListQuery(thread_db* tdbb, Impure* impure) const
{
	BitmapIndexScanContext* context = impure->irsb_scan_context;
	
	if (context->search_values.isEmpty()) {
		impure->irsb_bitmap_result = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
		return;
	}
	
	// Get bitmaps for all values in the IN list
	HalfStaticArray<RecordBitmap*, 8> value_bitmaps(*m_pool);
	
	for (size_t i = 0; i < context->search_values.getCount(); i++) {
		const dsc* search_value = &context->search_values[i];
		RecordBitmap* bitmap = getBitmapForValue(tdbb, search_value);
		
		if (bitmap) {
			value_bitmaps.add(bitmap);
		}
	}
	
	// Combine bitmaps using OR operation (union)
	impure->irsb_bitmap_result = combineBitmaps(tdbb, value_bitmaps, BITMAP_OP_OR);
	
	// Update statistics
	context->query_stats.bitmaps_processed = value_bitmaps.getCount();
	if (impure->irsb_bitmap_result) {
		context->query_stats.records_matched = impure->irsb_bitmap_result->getCount();
	}
}

void BitmapIndexTableScan::executeRangeQuery(thread_db* tdbb, Impure* impure) const
{
	// Range queries are more complex for bitmap indexes
	status_exception::raise(Arg::Gds(isc_feature_not_supported) << 
							Arg::Str("Range queries on bitmap indexes"));
}

void BitmapIndexTableScan::executeNullQuery(thread_db* tdbb, Impure* impure) const
{
	// Get bitmap for NULL values
	dsc null_value;
	null_value.dsc_dtype = dtype_unknown;
	null_value.dsc_flags = DSC_null;
	
	impure->irsb_bitmap_result = getBitmapForValue(tdbb, &null_value);
	
	if (!impure->irsb_bitmap_result) {
		impure->irsb_bitmap_result = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
	}
}

void BitmapIndexTableScan::executeNotNullQuery(thread_db* tdbb, Impure* impure) const
{
	// Get bitmap for NULL values and complement it
	executeNullQuery(tdbb, impure);
	
	if (impure->irsb_bitmap_result) {
		// Create complement bitmap (NOT operation)
		RecordBitmap* complement = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
		complement->complement(*impure->irsb_bitmap_result, estimateResultSize(tdbb, nullptr));
		
		delete impure->irsb_bitmap_result;
		impure->irsb_bitmap_result = complement;
	}
}

void BitmapIndexTableScan::executeMultiValueQuery(thread_db* tdbb, Impure* impure) const
{
	// Multi-value queries combine multiple bitmaps with specified operations
	status_exception::raise(Arg::Gds(isc_feature_not_supported) << 
							Arg::Str("Multi-value bitmap queries"));
}

//----------------------------
// Private helper methods
//----------------------------

RecordBitmap* BitmapIndexTableScan::getBitmapForValue(thread_db* tdbb, const dsc* value) const
{
	BitmapIndex* bitmap_index = getBitmapIndexInstance(tdbb);
	if (!bitmap_index) {
		return nullptr;
	}
	
	// Use the bitmap index to retrieve the bitmap for this value
	RecordBitmap* bitmap = bitmap_index->getBitmapForValue(tdbb, value);
	
	// Update cache statistics
	if (bitmap) {
		const_cast<BitmapIndexTableScan*>(this)->m_cache_hits++;
	} else {
		const_cast<BitmapIndexTableScan*>(this)->m_cache_misses++;
	}
	
	return bitmap;
}

RecordBitmap* BitmapIndexTableScan::combineBitmaps(thread_db* tdbb, 
												   const HalfStaticArray<RecordBitmap*, 8>& bitmaps,
												   BitmapOperation operation) const
{
	if (bitmaps.isEmpty()) {
		return FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
	}
	
	if (bitmaps.getCount() == 1) {
		// Single bitmap - create a copy
		RecordBitmap* result = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
		*result = *bitmaps[0];
		return result;
	}
	
	// Start with the first bitmap
	RecordBitmap* result = FB_NEW_POOL(*m_pool) RecordBitmap(*m_pool);
	*result = *bitmaps[0];
	
	// Combine with remaining bitmaps
	for (size_t i = 1; i < bitmaps.getCount(); i++) {
		switch (operation) {
		case BITMAP_OP_AND:
			result->intersect(*bitmaps[i]);
			break;
			
		case BITMAP_OP_OR:
			result->join(*bitmaps[i]);
			break;
			
		case BITMAP_OP_XOR:
			result->xor_with(*bitmaps[i]);
			break;
			
		case BITMAP_OP_NOT:
			// NOT operation is typically unary
			result->complement(*bitmaps[i], estimateResultSize(tdbb, nullptr));
			break;
		}
	}
	
	return result;
}

void BitmapIndexTableScan::optimizeBitmap(thread_db* tdbb, RecordBitmap* bitmap) const
{
	if (!bitmap) {
		return;
	}
	
	// Apply bitmap-specific optimizations
	bitmap->optimize();
}

void BitmapIndexTableScan::compressBitmap(thread_db* tdbb, RecordBitmap* bitmap) const
{
	if (!bitmap) {
		return;
	}
	
	// Apply compression to reduce memory usage
	bitmap->compress();
}

bool BitmapIndexTableScan::shouldUseCompression(thread_db* tdbb, ULONG bitmap_size) const
{
	// Use compression for larger bitmaps
	return bitmap_size > DEFAULT_CHUNK_SIZE && 
		   m_default_context.enable_compression;
}

BitmapExecutionStrategy BitmapIndexTableScan::selectOptimalStrategy(thread_db* tdbb, 
																	ULONG expected_results) const
{
	if (expected_results > PARALLEL_THRESHOLD_RECORDS) {
		return BITMAP_STRATEGY_PARALLEL;
	} else if (expected_results > DEFAULT_CHUNK_SIZE) {
		return BITMAP_STRATEGY_CHUNKED;
	} else {
		return BITMAP_STRATEGY_SEQUENTIAL;
	}
}

BitmapIndex* BitmapIndexTableScan::getBitmapIndexInstance(thread_db* tdbb) const
{
	// This would be implemented to get the actual bitmap index instance
	// For now, return nullptr as placeholder
	return nullptr;
}

void BitmapIndexTableScan::validateIndexSuitability(thread_db* tdbb, const dsc* search_value) const
{
	// Validate that the search value is suitable for bitmap index lookup
	if (!search_value) {
		status_exception::raise(Arg::Gds(isc_invalid_search_value));
	}
}

ULONG BitmapIndexTableScan::estimateResultSize(thread_db* tdbb, const dsc* search_value) const
{
	// Estimate the number of records that might match
	return m_relation ? m_relation->rel_total_records : 1000;
}

void BitmapIndexTableScan::deallocateWorkingBitmaps(thread_db* tdbb, Impure* impure) const
{
	for (size_t i = 0; i < impure->irsb_temp_bitmaps.getCount(); i++) {
		delete impure->irsb_temp_bitmaps[i];
	}
	impure->irsb_temp_bitmaps.clear();
}

void BitmapIndexTableScan::handleBitmapError(thread_db* tdbb, const Exception& error) const
{
	// Handle bitmap-specific errors with appropriate recovery
	// For now, just re-throw the exception
	throw;
}

//----------------------------
// BitmapIndexTableScanFactory Implementation
//----------------------------

BitmapIndexTableScan* BitmapIndexTableScanFactory::createEqualityScan(CompilerScratch* csb,
																	  const string& alias,
																	  StreamType stream, jrd_rel* relation,
																	  const index_desc* bitmap_index,
																	  const dsc* search_value,
																	  double selectivity)
{
	BitmapIndexTableScan* scan = FB_NEW_POOL(csb->csb_pool) BitmapIndexTableScan(
		csb, alias, stream, relation, bitmap_index, nullptr, nullptr, selectivity);
	
	scan->setSearchValue(search_value);
	scan->setQueryType(BITMAP_QUERY_EQUALITY);
	
	return scan;
}

BitmapIndexTableScan* BitmapIndexTableScanFactory::createInListScan(CompilerScratch* csb,
																	const string& alias,
																	StreamType stream, jrd_rel* relation,
																	const index_desc* bitmap_index,
																	const HalfStaticArray<dsc, 8>& search_values,
																	double selectivity)
{
	BitmapIndexTableScan* scan = FB_NEW_POOL(csb->csb_pool) BitmapIndexTableScan(
		csb, alias, stream, relation, bitmap_index, nullptr, nullptr, selectivity);
	
	scan->setSearchValues(search_values);
	scan->setQueryType(BITMAP_QUERY_IN_LIST);
	
	return scan;
}

bool BitmapIndexTableScanFactory::isBitmapIndexSuitable(thread_db* tdbb, const index_desc* index_desc,
													   BitmapQueryType query_type, ULONG expected_cardinality)
{
	// Check if bitmap index is suitable for the query type and cardinality
	return index_desc && 
		   index_desc->idx_itype == idx_bitmap && 
		   expected_cardinality <= 1000; // MAX_BITMAP_CARDINALITY placeholder
}

double BitmapIndexTableScanFactory::estimateBitmapSelectivity(thread_db* tdbb, const index_desc* index_desc,
															 const dsc* search_value)
{
	// Estimate selectivity based on bitmap index statistics
	return 0.1; // Placeholder - 10% selectivity
}

BitmapExecutionStrategy BitmapIndexTableScanFactory::recommendStrategy(thread_db* tdbb, 
																	   const index_desc* index_desc,
																	   ULONG expected_results)
{
	if (expected_results > 50000) {
		return BITMAP_STRATEGY_PARALLEL;
	} else if (expected_results > 10000) {
		return BITMAP_STRATEGY_CHUNKED;
	} else {
		return BITMAP_STRATEGY_SEQUENTIAL;
	}
}
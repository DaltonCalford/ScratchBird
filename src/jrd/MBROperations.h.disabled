#ifndef MBR_OPERATIONS_H
#define MBR_OPERATIONS_H

#include "SpatialDataTypes.h"
#include "../common/classes/alloc.h"
#include "../common/classes/array.h"
#include "../common/dsc.h"
#include <vector>
#include <algorithm>

namespace ScratchBird {

// Forward declarations
class RTreeNode;
class SpatialIndex;

// Extended MBR class with advanced spatial indexing operations
class ExtendedMBR : public MBR
{
public:
    ExtendedMBR() : MBR() {}
    ExtendedMBR(double x1, double y1, double x2, double y2) : MBR(x1, y1, x2, y2) {}
    ExtendedMBR(const MBR& other) : MBR(other.minX, other.minY, other.maxX, other.maxY) {}
    ExtendedMBR(const Coordinate& coord) : MBR(coord.x, coord.y, coord.x, coord.y) {}
    
    // Enhanced spatial relationship tests
    bool strictlyContains(const ExtendedMBR& other) const;
    bool touchesBoundary(const ExtendedMBR& other) const;
    bool overlapsArea(const ExtendedMBR& other) const;
    double overlapArea(const ExtendedMBR& other) const;
    double intersectionArea(const ExtendedMBR& other) const;
    
    // Distance and proximity operations
    double distance(const ExtendedMBR& other) const;
    double minDistance(const ExtendedMBR& other) const;
    double maxDistance(const ExtendedMBR& other) const;
    double centerDistance(const ExtendedMBR& other) const;
    bool isWithinDistance(const ExtendedMBR& other, double maxDistance) const;
    
    // Geometric calculations
    Coordinate getCenter() const;
    double getWidth() const { return maxX - minX; }
    double getHeight() const { return maxY - minY; }
    double getPerimeter() const { return 2.0 * (getWidth() + getHeight()); }
    double getDiagonalLength() const;
    double getAspectRatio() const;
    
    // Expansion and modification operations
    void expandByDistance(double distance);
    void expandByPercentage(double percentage);
    void expandToInclude(const Coordinate& coord);
    void expandToInclude(const ExtendedMBR& other);
    ExtendedMBR getExpanded(double distance) const;
    ExtendedMBR getExpanded(double xDistance, double yDistance) const;
    
    // Subdivision operations for R-Tree splitting
    std::pair<ExtendedMBR, ExtendedMBR> splitHorizontal(double ratio = 0.5) const;
    std::pair<ExtendedMBR, ExtendedMBR> splitVertical(double ratio = 0.5) const;
    std::vector<ExtendedMBR> subdivide(USHORT numX, USHORT numY) const;
    
    // Quality metrics for R-Tree optimization
    double getMargin() const { return getPerimeter(); }
    double getDeadSpace(const std::vector<ExtendedMBR>& children) const;
    double getCoverage(const std::vector<ExtendedMBR>& children) const;
    double getOverlap(const std::vector<ExtendedMBR>& siblings) const;
    
    // Coordinate system operations
    bool isNormalized() const;
    void normalize();
    ExtendedMBR getNormalized() const;
    
    // Comparison operations for sorting and searching
    bool equals(const ExtendedMBR& other, double tolerance = SPATIAL_PRECISION) const;
    int compareByArea(const ExtendedMBR& other) const;
    int compareByCenter(const ExtendedMBR& other) const;
    
    // Serialization helpers
    ScratchBird::string toString() const;
    static ExtendedMBR fromString(const ScratchBird::string& str);
    
    // Operators
    bool operator==(const ExtendedMBR& other) const;
    bool operator!=(const ExtendedMBR& other) const;
    ExtendedMBR operator+(const ExtendedMBR& other) const; // Union
    ExtendedMBR operator*(const ExtendedMBR& other) const; // Intersection
};

// MBR collections and bulk operations
class MBRCollection
{
private:
    std::vector<ExtendedMBR> mbrs;
    ExtendedMBR boundingMBR;
    bool boundingMBRValid;
    
public:
    MBRCollection();
    ~MBRCollection();
    
    // Collection management
    void add(const ExtendedMBR& mbr);
    void remove(ULONG index);
    void clear();
    ULONG size() const { return mbrs.size(); }
    bool isEmpty() const { return mbrs.empty(); }
    
    // Access operations
    const ExtendedMBR& operator[](ULONG index) const;
    ExtendedMBR& operator[](ULONG index);
    const std::vector<ExtendedMBR>& getMBRs() const { return mbrs; }
    
    // Aggregate operations
    ExtendedMBR getBoundingMBR();
    double getTotalArea() const;
    double getTotalOverlap() const;
    double getAverageArea() const;
    Coordinate getCentroid() const;
    
    // Spatial queries
    std::vector<ULONG> findIntersecting(const ExtendedMBR& queryMBR) const;
    std::vector<ULONG> findContained(const ExtendedMBR& queryMBR) const;
    std::vector<ULONG> findContaining(const ExtendedMBR& queryMBR) const;
    std::vector<ULONG> findWithinDistance(const ExtendedMBR& queryMBR, double distance) const;
    
    // Sorting and ordering
    void sortByArea(bool ascending = true);
    void sortByX(bool ascending = true);
    void sortByY(bool ascending = true);
    void sortByCenterDistance(const Coordinate& center, bool ascending = true);
    void sortByOverlap(const ExtendedMBR& reference, bool ascending = true);
    
    // R-Tree specific operations
    std::pair<MBRCollection, MBRCollection> splitLinear() const;
    std::pair<MBRCollection, MBRCollection> splitQuadratic() const;
    MBRCollection pickSeeds() const;
    ULONG findBestFit(const ExtendedMBR& newMBR) const;
    
private:
    void invalidateBoundingMBR() { boundingMBRValid = false; }
    void updateBoundingMBR();
};

// Specialized MBR operations for different spatial algorithms
namespace MBRAlgorithms
{
    // R-Tree splitting algorithms
    enum SplitStrategy
    {
        SPLIT_LINEAR,        // Linear-time split (R-Tree)
        SPLIT_QUADRATIC,     // Quadratic-time split (R-Tree)  
        SPLIT_R_STAR,        // R*-Tree split algorithm
        SPLIT_HILBERT,       // Hilbert R-Tree split
        SPLIT_PRIORITY       // Priority R-Tree split
    };
    
    // MBR optimization algorithms
    enum OptimizationStrategy
    {
        OPT_MINIMIZE_AREA,      // Minimize total area
        OPT_MINIMIZE_OVERLAP,   // Minimize overlap
        OPT_MINIMIZE_MARGIN,    // Minimize margin (R*-Tree)
        OPT_BALANCE_TREE,       // Balance tree structure
        OPT_MINIMIZE_DEAD_SPACE // Minimize dead space
    };
    
    // Splitting functions
    std::pair<MBRCollection, MBRCollection> linearSplit(const MBRCollection& mbrs);
    std::pair<MBRCollection, MBRCollection> quadraticSplit(const MBRCollection& mbrs);
    std::pair<MBRCollection, MBRCollection> rStarSplit(const MBRCollection& mbrs);
    
    // Seed selection for splitting
    std::pair<ULONG, ULONG> pickLinearSeeds(const MBRCollection& mbrs);
    std::pair<ULONG, ULONG> pickQuadraticSeeds(const MBRCollection& mbrs);
    
    // Insertion optimization
    ULONG chooseLeaf(const MBRCollection& candidates, const ExtendedMBR& newMBR, OptimizationStrategy strategy);
    ULONG chooseSplitAxis(const MBRCollection& mbrs);
    ULONG chooseSplitIndex(const MBRCollection& mbrs, ULONG axis);
    
    // Quality metrics
    double calculateDeadSpace(const ExtendedMBR& container, const MBRCollection& children);
    double calculateOverlap(const MBRCollection& mbrs);
    double calculateMargin(const MBRCollection& mbrs);
    double calculateAverageQueryCost(const MBRCollection& mbrs, const ExtendedMBR& queryMBR);
    
    // Bulk loading operations
    MBRCollection sortTileRecursive(const MBRCollection& mbrs, ULONG fanout);
    MBRCollection hilbertSort(const MBRCollection& mbrs);
    MBRCollection zOrderSort(const MBRCollection& mbrs);
    
    // Nearest neighbor operations
    std::vector<ULONG> findKNearestNeighbors(const MBRCollection& mbrs, const ExtendedMBR& query, ULONG k);
    std::vector<ULONG> findWithinRadius(const MBRCollection& mbrs, const Coordinate& center, double radius);
    
    // Clustering operations
    std::vector<MBRCollection> clusterByProximity(const MBRCollection& mbrs, double maxDistance);
    std::vector<MBRCollection> clusterBySize(const MBRCollection& mbrs, ULONG maxSize);
    MBRCollection createConvexHull(const MBRCollection& mbrs);
}

// MBR statistics and analysis
class MBRStatistics
{
private:
    const MBRCollection& collection;
    
public:
    MBRStatistics(const MBRCollection& mbrs) : collection(mbrs) {}
    
    // Basic statistics
    double getMinArea() const;
    double getMaxArea() const;
    double getAverageArea() const;
    double getMedianArea() const;
    double getAreaStandardDeviation() const;
    
    // Spatial distribution statistics
    double getAverageOverlap() const;
    double getMaxOverlap() const;
    double getCoverageRatio() const;
    double getFragmentation() const;
    
    // Quality metrics
    double getBalanceFactor() const;
    double getClusteringFactor() const;
    double getUniformityIndex() const;
    
    // Distribution analysis
    std::pair<double, double> getCenterDistribution() const; // mean, std dev
    std::pair<double, double> getSizeDistribution() const;   // mean, std dev
    
    // Report generation
    ScratchBird::string generateReport() const;
    void analyzePerformance(const std::vector<ExtendedMBR>& queries, ScratchBird::string& report) const;
};

// MBR validation and repair utilities
namespace MBRValidation
{
    // Validation functions
    bool isValidMBR(const ExtendedMBR& mbr);
    bool isValidCollection(const MBRCollection& collection);
    std::vector<ScratchBird::string> validateMBR(const ExtendedMBR& mbr);
    std::vector<ScratchBird::string> validateCollection(const MBRCollection& collection);
    
    // Repair functions
    ExtendedMBR repairMBR(const ExtendedMBR& mbr);
    MBRCollection repairCollection(const MBRCollection& collection);
    
    // Consistency checking
    bool checkContainment(const ExtendedMBR& parent, const MBRCollection& children);
    bool checkOverlapConsistency(const MBRCollection& collection);
    
    // Quality assessment
    double assessQuality(const MBRCollection& collection);
    ScratchBird::string generateQualityReport(const MBRCollection& collection);
}

// Performance optimization utilities
namespace MBROptimization
{
    // Cache-friendly operations
    class MBRCache
    {
    private:
        struct CacheEntry
        {
            ExtendedMBR mbr;
            FB_UINT64 lastAccess;
            bool dirty;
        };
        
        std::vector<CacheEntry> cache;
        ULONG maxSize;
        FB_UINT64 accessCounter;
        
    public:
        MBRCache(ULONG size = 1000);
        ~MBRCache();
        
        bool get(ULONG id, ExtendedMBR& mbr);
        void put(ULONG id, const ExtendedMBR& mbr);
        void remove(ULONG id);
        void clear();
        
        // Statistics
        double getHitRate() const;
        ULONG getSize() const { return cache.size(); }
        
    private:
        void evictOldest();
    };
    
    // Batch operations for better performance
    std::vector<bool> batchIntersects(const ExtendedMBR& query, const MBRCollection& collection);
    std::vector<bool> batchContains(const ExtendedMBR& query, const MBRCollection& collection);
    std::vector<double> batchDistances(const ExtendedMBR& query, const MBRCollection& collection);
    
    // Parallel processing support
    void parallelSort(MBRCollection& collection, int numThreads = 0);
    std::vector<ULONG> parallelSearch(const ExtendedMBR& query, const MBRCollection& collection, int numThreads = 0);
    
    // Memory optimization
    void compactCollection(MBRCollection& collection);
    ULONG estimateMemoryUsage(const MBRCollection& collection);
}

} // namespace ScratchBird

#endif // MBR_OPERATIONS_H
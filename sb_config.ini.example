# ScratchBird Configuration File Example
# Copy this file to sb_config.ini and modify as needed

# Garbage Collection Configuration
[garbage_collection]
# GC policy: COOPERATIVE, BACKGROUND, or COMBINED (default: COMBINED)
# - COOPERATIVE: Only cleanup during page reads (low overhead)
# - BACKGROUND: Only dedicated GC thread (predictable performance)
# - COMBINED: Both cooperative and background (best overall)
policy = COMBINED

# Background GC interval in milliseconds (default: 5000 = 5 seconds)
# Minimum: 100ms, Maximum: 3600000ms (1 hour)
# Lower values = more frequent GC passes = less garbage accumulation
# Higher values = less CPU overhead = more garbage between passes
background_interval_ms = 5000

# Cooperative GC rate: Run GC on 1 in N page reads (default: 100 = 1%)
# Minimum: 1 (every page read), Maximum: 10000 (0.01% of reads)
# Lower values = more aggressive cleanup = higher overhead
# Higher values = less overhead = slower garbage reclamation
cooperative_rate = 100

# Enable/disable garbage collection (default: true)
enabled = true

# Buffer Pool Configuration
[memory]
# Buffer pool size in pages (default: 128)
buffer_pool_size = 128

# Storage Configuration
[storage]
# Starting page for heap scans (default: 7)
heap_scan_start_page = 7

# Transaction Configuration
[transaction]
# Maximum concurrent backends (default: 64)
max_backends = 64

# Logging Configuration
[logging]
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
level = INFO

# Time Configuration
[server.time]
# Default time-of-day used when normalizing DATE values to UTC
# Format: HH:MM:SS (default: 00:00:00)
date_default_time = 00:00:00
